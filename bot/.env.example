# Токен бота от @BotFather (не публикуйте и не присылайте в чат)
BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOT_TOKEN

# Telegram ID первого администратора (число). Узнать: напишите @userinfobot
ADMIN_TELEGRAM_ID=123456789

# SQLite по умолчанию. Путь относительно каталога проекта или абсолютный.
# На сервере (Docker) docker-compose сам подставит sqlite:///./data/avoperenos.db
DATABASE_URL=sqlite:///./avoperenos.db

# Часовой пояс школы
TIMEZONE=Europe/Moscow

# Если START_BOT не достучивается до api.telegram.org (таймаут) —
# включите VPN или укажите прокси (HTTP/SOCKS). Пример:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=http://127.0.0.1:7890
TELEGRAM_PROXY=
